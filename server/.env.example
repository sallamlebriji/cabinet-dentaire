# ---- Serveur ----
NODE_ENV=development
PORT=4600
CLIENT_ORIGIN=http://localhost:5600

# ---- MySQL / MariaDB ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nacre_dental
# URL utilisée par Prisma (migrations + seeder) — doit correspondre aux valeurs ci-dessus
DATABASE_URL="mysql://root:@127.0.0.1:3306/nacre_dental"

# ---- Sécurité ----
JWT_SECRET=change-me-with-a-long-random-string
SESSION_MINUTES=30

# ---- IA (optionnel) : active l'assistant Claude côté serveur ----
ANTHROPIC_API_KEY=
